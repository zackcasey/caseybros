---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const title = 'built-ins' .replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
---
<BaseLayout title={`${title} | Casey Brothers Custom Builds`}>
  <Nav />
  <section class="pt-32 pb-24 bg-[#f5f0e8] min-h-screen">
    <div class="mx-auto max-w-7xl px-6">
      <p class="eyebrow mb-4">Our Work</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-[#211810] mb-6">{title}</h1>
      <p class="text-[#4f4035] max-w-xl leading-relaxed mb-12">Gallery coming soon. In the meantime, <a href="/contact" class="underline hover:text-[#211810]">get in touch</a> to start your project.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <img src="/images/project-04.png" alt="Project" class="rounded w-full h-64 object-cover">
        <img src="/images/project-08.png" alt="Project" class="rounded w-full h-64 object-cover">
        <img src="/images/project-shelving.jpg" alt="Project" class="rounded w-full h-64 object-cover">
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
